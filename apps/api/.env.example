DATABASE_URL="postgresql://replydeck:replydeck@localhost:5433/replydeck?schema=public"
PORT=4000
DEV_USER_ID=
DEV_USER_EMAIL=demo@replydeck.local
DEV_USER_NAME=Demo User
CORS_ORIGIN=*

# Phase 3 — Microsoft Graph (Outlook)
# Azure App Registration → Application (client) ID
MICROSOFT_CLIENT_ID=
# Azure App Registration → client secret value (NOT secret id)
MICROSOFT_CLIENT_SECRET=
# "common" for personal+work, "consumers" for personal only, or your tenant id
MICROSOFT_TENANT_ID=common
# Must exactly match the Azure redirect URI registered for this app
MICROSOFT_REDIRECT_URI=http://localhost:4000/auth/microsoft/callback
# Where the user is redirected AFTER the callback completes (a route in your app)
APP_REDIRECT_AFTER_AUTH=http://localhost:4000/auth/connected

# Token-at-rest encryption key (AES-256-GCM)
# Generate with: openssl rand -hex 32
# 64 hex chars = 32 bytes
TOKEN_ENCRYPTION_KEY=

# OAuth state cookie security (set false only when running over plain http on localhost)
OAUTH_COOKIE_SECURE=false

DATABASE_URL="postgresql://replydeck:replydeck@localhost:5433/replydeck?schema=public"
PORT=4000
DEV_USER_ID=
DEV_USER_EMAIL=demo@replydeck.local
DEV_USER_NAME=Demo User
CORS_ORIGIN=*

# Phase 3 — Microsoft Graph (Outlook)
# Azure App Registration → Application (client) ID
MICROSOFT_CLIENT_ID=
# Azure App Registration → client secret value (NOT secret id)
MICROSOFT_CLIENT_SECRET=
# "common" for personal+work, "consumers" for personal only, or your tenant id
MICROSOFT_TENANT_ID=common
# Must exactly match the Azure redirect URI registered for this app
MICROSOFT_REDIRECT_URI=http://localhost:4000/auth/microsoft/callback
# Where the user is redirected AFTER the callback completes (a route in your app)
APP_REDIRECT_AFTER_AUTH=http://localhost:4000/auth/connected

# Token-at-rest encryption key (AES-256-GCM)
# Generate with: openssl rand -hex 32
# 64 hex chars = 32 bytes
TOKEN_ENCRYPTION_KEY=

# OAuth state cookie security (set false only when running over plain http on localhost)
OAUTH_COOKIE_SECURE=false

# Phase 4 — AI drafting
# Provider: "mock" (deterministic, no network) or "anthropic" (real Claude Sonnet 4.6).
# Defaults to "mock" if unset OR if ANTHROPIC_API_KEY is missing.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
# Optional overrides — defaults are usually fine.
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MAX_TOKENS=1024
# ANTHROPIC_EFFORT=medium

# Phase 6 — Push delivery
# Driver: "mock" (default, no network — logs only), "apns" (iOS via @parse/node-apn),
# "fcm" (Android via firebase-admin), or "expo" (recommended for Expo apps — uses
# https://exp.host/--/api/v2/push/send; handles both iOS and Android without any
# APNs key or FCM service-account JSON).
# Set PUSH_DRIVER=expo once the Expo app is running on a real device and has called
# POST /push-tokens to register an ExponentPushToken.
PUSH_DRIVER=expo
# APNs (iOS) — token-based auth (.p8). Required when PUSH_DRIVER=apns.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.replydeck.app
APNS_KEY_PATH=
# FCM (Android) — GCP service account JSON path. Required when PUSH_DRIVER=fcm.
GOOGLE_APPLICATION_CREDENTIALS=

# Phase 6 — Microsoft Graph push notifications
# Public HTTPS base URL Graph will POST notifications to. In production this is
# your Fly.io API hostname; in dev, run `cloudflared tunnel --url http://localhost:4000`
# and paste the printed https URL here. The webhook path /webhooks/microsoft-graph
# is appended automatically when creating subscriptions.
# Production: https://replydeck-api.fly.dev
PUBLIC_WEBHOOK_BASE_URL=https://replydeck-api.fly.dev

# Redis for BullMQ — required to actually process graph webhook notifications
# and to run the subscription renewal cron. Leave unset to run without queues
# (the module logs a warning and continues; OAuth + manual sync still work).
REDIS_URL=redis://localhost:6379
